{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 -m http.server:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "WebFetch(domain:localhost)"
    ]
  }
}
